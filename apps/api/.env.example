# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Security & JWT
JWT_SECRET=platina-ai-development-super-secret-key-32chars
JWT_EXPIRES_IN=7d
DEMO_USER_PASSWORD=change_me

# CORS
CORS_ORIGIN=*

# AI & LLM Provider Configuration
AI_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Ingestion Service RPC / HTTP URL
INGESTION_SERVICE_URL=http://localhost:8000

# PSN Official API Crawler Worker
PSN_WORKER_EMAIL=psncrawlerai@gmail.com
PSN_WORKER_NPSSO=
